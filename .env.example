# Gerado pelo scripts\criar-banco.ps1 — não precisa escrever à mão.
# O `options=-c timezone=UTC` é obrigatório: sem ele o driver grava os horários
# 3 horas deslocados, em silêncio.
# No notebook, com o banco do PC de casa, troque só o host por 100.65.76.22.
DATABASE_URL="postgresql://neurobeat:<senha>@127.0.0.1:5432/neurobeat?options=-c%20timezone%3DUTC"
